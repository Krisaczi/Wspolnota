{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zarzadzanie Wspolnota Mieszkaniowa",
  "version": "1.0.0",
  "identifier": "com.housingcommunity.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zarzadzanie Wspolnota Mieszkaniowa",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Housing Community Manager",
    "copyright": "",
    "category": "Business",
    "shortDescription": "Offline housing community management",
    "longDescription": "Manage housing communities: apartments, owners, billing, meters, payments and accounting. Fully offline with local SQLite storage.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Polish"],
        "displayLanguageSelector": true,
        "compression": "lzma"
      },
      "wix": {
        "language": ["en-US", "pl-PL"]
      }
    },
    "resources": []
  },
  "plugins": {}
}
